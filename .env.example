# Necessário somente para conectar aparelhos que estão em redes diferentes.
# Use um servidor TURN sob seu controle e mantenha a senha fora do Git.
# Recomendado: Cloudflare Realtime TURN. Segredos somente no servidor.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
TURN_TTL_SECONDS=3600

# Alternativa autogerenciada com coturn:
# TURN_URLS=["turn:turn.seudominio.com:3478?transport=udp","turn:turn.seudominio.com:3478?transport=tcp","turns:turn.seudominio.com:5349?transport=tcp"]
# TURN_SHARED_SECRET=gere-um-segredo-longo-e-aleatorio

STUN_URLS=["stun:stun.cloudflare.com:3478"]
PUBLIC_URL=https://ponte.seudominio.com
TRUST_PROXY=false
PORT=4173
HOST=0.0.0.0
